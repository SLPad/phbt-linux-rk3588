&u2phy1 {
	status = "disabled";
};

&u2phy2 {
	status = "disabled";
};

&u2phy3 {
	status = "disabled";
};

&u2phy0_otg {
	status = "okay";
	rockchip,typec-vbus-det;
};

&u2phy1_otg {
	status = "disabled";
};

&u2phy2_host {
	status = "disabled";
};

&u2phy3_host {
	status = "disabled";
};

