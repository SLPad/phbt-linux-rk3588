# PHBT ARM64 QEMU virt: direct kernel boot, virtio disk/network/display/input.
CONFIG_LOCALVERSION="-phbt-qemu"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_PCI=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_INPUT=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_INPUT_EVDEV=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_CGROUPS=y
CONFIG_SECCOMP=y
# This Rockchip BSP changes the shared HDMI interface; virt uses no Meson display.
# CONFIG_DRM_MESON is not set
# Unused physical camera driver retains an incompatible V4L2 callback in this BSP.
# CONFIG_VIDEO_MAX96712 is not set
# virtio-gpu replaces physical KMS; BSP Rockchip modules use built-in-only symbols.
# CONFIG_DRM_ROCKCHIP is not set
# CONFIG_DRM_ANALOGIX_DP is not set
# BSP panel-simple also registers with physical Rockchip DRM, absent on virt.
# CONFIG_DRM_PANEL_SIMPLE is not set
